# Reference only: export these in your shell/service; no automatic .env loader.
LAMSA_ROOT=.
LAMSA_DB=data/store.sqlite
LAMSA_HOST=127.0.0.1
LAMSA_PORT=8080
LAMSA_ORIGIN=http://localhost:8080
LAMSA_SECURE_COOKIE=0
# Keep 0 until the owner approves live orders. Admin setting is also required.
LAMSA_ALLOW_ORDERS=0
# Maximum order attempts per source address per minute. Production default:
LAMSA_ORDER_LIMIT=10
# Only for --create-admin. Supply a private password through a hidden prompt.
LAMSA_ADMIN_USER=owner
# LAMSA_ADMIN_PASSWORD (never store a real value here)
